+    );
+    res.status(200).json({ account: accountDetail });
+  } catch (err) {
+    if (err instanceof AccountNotFoundError) {
+      next(new HttpError(404, PERSIAN.ACCOUNT_NOT_FOUND, "ACCOUNT_NOT_FOUND"));
+      return;
+    }
+    next(err);
+  }
+}
