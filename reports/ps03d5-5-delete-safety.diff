+export const DeleteAccountInput = z
+  .object({
+    accountId: z.string().uuid(),
+  })
+  .strict();
+
+export type DeleteAccountInput = z.infer<typeof DeleteAccountInput>;
+
+/**
+ * Hard-delete an Account when it has no Customer Assignment history.
+ *
+ * Assignment history means any capacity_customers row associated with any
+ * Capacity belonging to the Account, regardless of status or deletedAt. The
+ * operation locks the Account and its Capacities so a concurrent assignment
+ * insert cannot race past the history check.
+ *
+ * Child Capacities and Backup Codes are deleted explicitly because the schema
+ * foreign keys use ON DELETE NO ACTION.
+ */
+export async function deleteAccount(input: unknown): Promise<void> {
+  const parsed = DeleteAccountInput.parse(input);
+
+  await db.transaction(async (tx) => {
+    const client = tx as unknown as DbClient;
+
+    const [account] = await client
+      .select()
+      .from(accountsTable)
+      .where(
+        and(
+          eq(accountsTable.id, parsed.accountId),
+          isNull(accountsTable.deletedAt),
+        ),
+      )
+      .limit(1)
+      .for("update");
+
+    if (!account) {
+      throw new AccountNotFoundError();
+    }
+
+    // Lock every Capacity belonging to this Account so a concurrent assignment
+    // insert is serialized after the delete transaction. PostgreSQL FK checks on
+    // the assignment row will wait for these row locks; once the Account and its
+    // Capacities are deleted, the FK check fails and the assignment cannot be
+    // created.
+    const capacities = await client
+      .select()
+      .from(accountCapacitiesTable)
+      .where(eq(accountCapacitiesTable.accountId, account.id))
+      .for("update");
+
+    const capacityIds = capacities.map((c) => c.id);
+    if (capacityIds.length > 0) {
+      const [assignment] = await client
+        .select({ id: capacityCustomersTable.id })
+        .from(capacityCustomersTable)
+        .where(inArray(capacityCustomersTable.capacityId, capacityIds))
+        .limit(1);
+      if (assignment) {
+        throw new AccountHasAssignmentHistoryError();
+      }
+    }
+
+    // Explicit child deletion is required because the FKs are ON DELETE NO ACTION.
+    await client
+      .delete(accountBackupCodesTable)
+      .where(eq(accountBackupCodesTable.accountId, account.id));
+    await client
+      .delete(accountCapacitiesTable)
+      .where(eq(accountCapacitiesTable.accountId, account.id));
+    await client.delete(accountsTable).where(eq(accountsTable.id, account.id));
+  });
+}
